{
  "schema_version": 1,
  "required_environment": {
    "DOKA_CLOUD_BASE_URL": "https://example.invalid",
    "DOKA_CLOUD_USER_A_TOKEN": "<pre-created-user-a-access-token>",
    "DOKA_CLOUD_USER_B_TOKEN": "<pre-created-user-b-access-token>",
    "DOKA_CLOUD_50MIB_FILE": "<optional-exact-52428800-byte-fixture>"
  },
  "acceptance": {
    "gate_9": [
      "health",
      "user_a_list",
      "user_a_upload",
      "upload_integrity",
      "user_a_update",
      "user_a_download_integrity",
      "user_a_trash_restore",
      "permanent_cleanup",
      "exact_50_mib_boundary",
      "exact_50_mib_download_integrity"
    ],
    "gate_10": [
      "user_b_cannot_list_user_a_document",
      "user_b_cannot_download_user_a_document"
    ],
    "gate_11": [
      "supabase_source_path",
      "b2_over_50_mib_path",
      "cloudinary_derivative_under_10_mib",
      "google_drive_export_and_recovery"
    ]
  },
  "privacy": {
    "tokens_recorded": false,
    "emails_recorded": false
  },
  "upload_contract": {
    "session_endpoint": "/api/storage/upload-session",
    "direct_upload": "HTTPS signed provider URL; file bytes do not pass through Worker",
    "completion_endpoint": "/api/storage/upload-complete",
    "download_integrity": "SHA-256 of actual downloaded bytes must match expected digest"
  }
}
