    "download_integrity": "SHA-256 of actual downloaded bytes must match expected digest"
  },
  "required_for_full_gate_closure": {
    "DOKA_CLOUD_50MIB_FILE": "Exact 52428800-byte regular non-symlink fixture; required for Gate 9 PASS, although the runner can execute partial lifecycle checks without it."
  }
