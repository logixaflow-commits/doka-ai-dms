# =============================================================================
# Office DMS - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Core Application --------------------------------------------------------
ENVIRONMENT=development
DEBUG=False
SECRET_KEY=

# --- Encryption (Fernet AES-128) ---------------------------------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Database ----------------------------------------------------------------
# PostgreSQL (Production):
# DATABASE_URL=postgresql://dms_user:dms_password@localhost:5432/dms_db
# SQLite (Development - uncomment to use):
# DATABASE_URL=sqlite:///./dms.db

# --- Redis & Celery ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- MinIO Object Storage ----------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=False
MINIO_BUCKET_NAME=logistics-documents

# --- File System Paths -------------------------------------------------------
# Original source (for example D:\\OfficeFiles). The application must treat it as read-only.
# SOURCE_ROOT=D:\\OfficeFiles
SOURCE_ROOT=
WORKING_ROOT=./Office_DMS/Workspace
FINAL_ROOT=./Office_DMS/Workspace/Final
QUARANTINE_ROOT=./Office_DMS/Workspace/Quarantine
BACKUP_ROOT=./Office_DMS/Backups
ORIGINAL_READ_ONLY=true
ALLOW_SOURCE_WRITE=false

# Backward-compatible paths
WATCH_FOLDER=./Office_DMS/Workspace/Watch_Folder
PROCESSING_WORKSPACE=./Office_DMS/Workspace/Processing_Workspace
ORGANIZED_ROOT=./Office_DMS/Workspace/Final
DUPLICATE_FOLDER=./Office_DMS/Workspace/Duplicates
SUSPICIOUS_FOLDER=./Office_DMS/Workspace/Quarantine/Suspicious
LOG_DIR=./logs

# --- OCR Configuration -------------------------------------------------------
TESSERACT_CMD=tesseract
MYANMAR_LANG=mya
OCR_DPI=300
OCR_PREPROCESSING=false
TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata

BOOTSTRAP_ADMIN_PASSWORD=

# --- Security & Compliance ---------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# --- Monitoring --------------------------------------------------------------
SENTRY_DSN=

# --- AI Services (Optional - for enhanced duplicate detection) ------------------
# OpenAI API for AI-powered document analysis and duplicate detection
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini API for Google AI-powered document analysis
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Hugging Face API for AI model inference
# Get your API key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OpenRouter API for multiple AI model access
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Groq API for ultra-fast AI inference
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Enable AI-enhanced features
# AI is OFF by default. Local rules/OCR/TF-IDF work without paid APIs.
AI_ENABLED=false
AI_ENHANCED_DUPLICATE_DETECTION=false
AI_CLASSIFICATION_ENABLED=false
# Free-first order; failed/rate-limited providers are skipped automatically.
AI_PROVIDER_ORDER=gemini,openrouter,groq,openai
AI_PROVIDER_MAX_ATTEMPTS=0
AI_PROVIDER_TIMEOUT_SECONDS=30

# --- Backup ------------------------------------------------------------------
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# --- Email/SMTP Configuration (Enterprise Feature) -------------------------
# Email notifications for document rejection, ETA overdue, etc.
SMTP_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Enterprise DMS
ADMIN_EMAIL=