# ==============================================================================
# DOKA-AI-DMS: PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# Target Deployment: Render (API Backend), Vercel/Netlify (Web), Electron (Desktop)
# Architecture: 100% Standalone Decoupled Document Management System
# Format: [Platform / Component Target] [Variable Name]=
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER — BACKEND API (Core Web Service)
# ------------------------------------------------------------------------------
# Render — Backend API	ENVIRONMENT
ENVIRONMENT=production

# Render — Backend API	DEBUG
DEBUG=false

# Render — Backend API	PORT
PORT=8002

# Render — Backend API	FRONTEND_BASE_URL
FRONTEND_BASE_URL=https://doka-dms.vercel.app

# Render — Backend API	CORS_ORIGINS
CORS_ORIGINS=https://doka-dms.vercel.app,https://doka-dms.netlify.app

# Render — Backend API	CORS_EXTRA_ORIGINS
CORS_EXTRA_ORIGINS=

# Render — Backend API	SECRET_KEY (Generate with: openssl rand -hex 32)
SECRET_KEY=

# Render — Backend API	ENCRYPTION_KEY (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Render — Backend API	LOCAL_ADMIN_USERNAME
LOCAL_ADMIN_USERNAME=admin

# Render — Backend API	BOOTSTRAP_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_PASSWORD=

# Render — Backend API	DATABASE_URL (PostgreSQL pooled connection string)
DATABASE_URL=

# Render — Backend API	SENTRY_DSN
SENTRY_DSN=

# Render — Backend API	SENTRY_ENVIRONMENT
SENTRY_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. RENDER — SUPABASE AUTH & DOCUMENT STORAGE
# ------------------------------------------------------------------------------
# Render — Supabase	SUPABASE_URL
SUPABASE_URL=

# Render — Supabase	SUPABASE_PUBLISHABLE_KEY
SUPABASE_PUBLISHABLE_KEY=

# Render — Supabase	SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Render — Supabase	DOKA_SINGLE_USER_EMAIL
DOKA_SINGLE_USER_EMAIL=

# ------------------------------------------------------------------------------
# 3. RENDER — MULTI-STORAGE MATRIX (Cloudinary, Backblaze B2, Supabase, Local)
# ------------------------------------------------------------------------------
# Render — Storage	DOKA_STORAGE_PROVIDER (hybrid, cloudinary, b2, supabase, local)
DOKA_STORAGE_PROVIDER=hybrid

# Render — Storage	CLOUDINARY_CLOUD_NAME
CLOUDINARY_CLOUD_NAME=

# Render — Storage	CLOUDINARY_API_KEY
CLOUDINARY_API_KEY=

# Render — Storage	CLOUDINARY_API_SECRET
CLOUDINARY_API_SECRET=

# Render — Storage	B2_APPLICATION_KEY_ID
B2_APPLICATION_KEY_ID=

# Render — Storage	B2_APPLICATION_KEY
B2_APPLICATION_KEY=

# Render — Storage	B2_BUCKET_NAME
B2_BUCKET_NAME=doka-document-vault

# Render — Storage	B2_REGION
B2_REGION=us-west-004

# Render — Storage	B2_ENDPOINT_URL
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com

# Render — Storage	B2_SIGNED_URL_EXPIRY_SECONDS
B2_SIGNED_URL_EXPIRY_SECONDS=900

# Render — Storage	DOKA_STORAGE_MAX_OBJECT_BYTES (50MB default)
DOKA_STORAGE_MAX_OBJECT_BYTES=52428800

# Render — Storage	BACKUP_RETENTION_DAYS
BACKUP_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 4. RENDER — OCR & MYANMAR LANGUAGE ENGINE
# ------------------------------------------------------------------------------
# Render — OCR	TESSERACT_CMD
TESSERACT_CMD=/usr/bin/tesseract

# Render — OCR	MYANMAR_LANG
MYANMAR_LANG=mya

# Render — OCR	OCR_DPI
OCR_DPI=400

# Render — OCR	OCR_PREPROCESSING
OCR_PREPROCESSING=true

# Render — OCR	TESSDATA_PREFIX
TESSDATA_PREFIX=

# Render — OCR	OCR_POPPLER_PATH
OCR_POPPLER_PATH=

# ------------------------------------------------------------------------------
# 5. RENDER — MULTI-PROVIDER AI & RECEIPT EXTRACTION
# ------------------------------------------------------------------------------
# Render — AI Providers	AI_ENABLED
AI_ENABLED=true

# Render — AI Providers	AI_EXTERNAL_PROCESSING_CONSENT
AI_EXTERNAL_PROCESSING_CONSENT=true

# Render — AI Providers	AI_PROVIDER_ORDER
AI_PROVIDER_ORDER=openrouter,gemini,groq,mistral,cohere

# Render — AI Providers	OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# Render — AI Providers	OPENROUTER_MODEL
OPENROUTER_MODEL=openrouter/free

# Render — AI Providers	OPENROUTER_EMBEDDING_MODEL
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free

# Render — AI Providers	GEMINI_API_KEY
GEMINI_API_KEY=

# Render — AI Providers	GEMINI_MODEL
GEMINI_MODEL=gemini-2.5-flash

# Render — AI Providers	GROQ_API_KEY
GROQ_API_KEY=

# Render — AI Providers	GROQ_MODEL
GROQ_MODEL=llama-3.3-70b-versatile

# Render — AI Providers	MISTRAL_API_KEY
MISTRAL_API_KEY=

# Render — AI Providers	MISTRAL_MODEL
MISTRAL_MODEL=mistral-small-latest

# Render — AI Providers	COHERE_API_KEY
COHERE_API_KEY=

# Render — AI Providers	COHERE_MODEL
COHERE_MODEL=command-r-08-2024

# Render — AI Providers	NVIDIA_API_KEY
NVIDIA_API_KEY=

# Render — AI Providers	NVIDIA_MODEL
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Render — AI Providers	HUGGINGFACE_API_KEY
HUGGINGFACE_API_KEY=

# Render — AI Providers	HUGGINGFACE_MODEL
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Render — AI Providers	VOYAGE_API_KEY
VOYAGE_API_KEY=

# Render — AI Providers	VOYAGE_MODEL
VOYAGE_MODEL=voyage-3-lite

# ------------------------------------------------------------------------------
# 6. RENDER — QDRANT VECTOR DOCUMENT SEARCH
# ------------------------------------------------------------------------------
# Render — Qdrant	QDRANT_API_KEY
QDRANT_API_KEY=

# Render — Qdrant	QDRANT_CLUSTER_ENDPOINT
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io

# Render — Qdrant	QDRANT_COLLECTION_NAME
QDRANT_COLLECTION_NAME=doka_document_vectors

# ------------------------------------------------------------------------------
# 7. RENDER — UPSTASH QSTASH & REDIS (Batch OCR Queue & Caching)
# ------------------------------------------------------------------------------
# Render — Upstash QStash	QSTASH_URL
QSTASH_URL=https://qstash.upstash.io

# Render — Upstash QStash	QSTASH_TOKEN
QSTASH_TOKEN=

# Render — Upstash QStash	QSTASH_CURRENT_SIGNING_KEY
QSTASH_CURRENT_SIGNING_KEY=

# Render — Upstash QStash	QSTASH_NEXT_SIGNING_KEY
QSTASH_NEXT_SIGNING_KEY=

# Render — Upstash Redis	REDIS_URL
REDIS_URL=

# Render — Upstash Redis	UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_URL=

# Render — Upstash Redis	UPSTASH_REDIS_REST_TOKEN
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 8. RENDER — OBSERVABILITY, LOGS & PRIVACY ANALYTICS
# ------------------------------------------------------------------------------
# Render — Observability	AXIOM_TOKEN
AXIOM_TOKEN=

# Render — Observability	AXIOM_DATASET
AXIOM_DATASET=doka-dms-production

# Render — Observability	UMAMI_WEBSITE_ID
UMAMI_WEBSITE_ID=

# Render — Observability	UMAMI_HOST_URL
UMAMI_HOST_URL=https://cloud.umami.is

# ------------------------------------------------------------------------------
# 9. RENDER — GOOGLE DRIVE OAUTH (Document Sync & Archive)
# ------------------------------------------------------------------------------
# Render — Google Drive	GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Render — Google Drive	GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_SECRET=

# Render — Google Drive	GOOGLE_DRIVE_REDIRECT_URI
GOOGLE_DRIVE_REDIRECT_URI=https://doka-dms-api.onrender.com/api/integrations/google-drive/callback

# Render — Google Drive	GOOGLE_DRIVE_REFRESH_TOKEN
GOOGLE_DRIVE_REFRESH_TOKEN=

# Render — Google Drive	GOOGLE_DRIVE_FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID=

# Render — Google Drive	GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=

# Render — Google Drive	GOOGLE_OAUTH_STATE_SECRET
GOOGLE_OAUTH_STATE_SECRET=

# ------------------------------------------------------------------------------
# 10. RENDER — TELEGRAM BOT & DOCUMENT INGESTION
# ------------------------------------------------------------------------------
# Render — Telegram	TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=

# Render — Telegram	TELEGRAM_CHAT_ID
TELEGRAM_CHAT_ID=

# Render — Telegram	TELEGRAM_TOPIC_ID
TELEGRAM_TOPIC_ID=

# Render — Telegram	TELEGRAM_ENABLED
TELEGRAM_ENABLED=false

# Required on the FastAPI service only when Telegram inbound webhooks are enabled.
# Set the same random value with Telegram setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET=

# Required only for trusted internal gateway POST /api/telegram/action calls.
TELEGRAM_ACTION_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 11. VERCEL / NETLIFY — WEB FRONTEND (Public Bundle)
# ------------------------------------------------------------------------------
# Vercel — Web Frontend	VITE_API_URL
VITE_API_URL=https://doka-dms-api.onrender.com

# Vercel — Web Frontend	VITE_SUPABASE_URL
VITE_SUPABASE_URL=

# Vercel — Web Frontend	VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_ANON_KEY=

# Vercel — Web Frontend	VITE_UMAMI_WEBSITE_ID
VITE_UMAMI_WEBSITE_ID=

# Vercel — Web Frontend	VITE_UMAMI_SCRIPT_URL
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# ------------------------------------------------------------------------------
# 12. ELECTRON & MOBILE CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Desktop / Mobile	DOKA_DESKTOP_API_TARGET=https://doka-dms-api.onrender.com
DOKA_DESKTOP_API_TARGET=https://doka-dms-api.onrender.com

# Desktop / Mobile	EXPO_PUBLIC_API_URL
EXPO_PUBLIC_API_URL=https://doka-dms-api.onrender.com
