# ==============================================================================
# DOKA-AI-DMS: PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# (Non-Docker Native / Systemd / PM2 Deployment)
#
# Instructions:
# 1. Copy this file to .env or apps/web-platform/backend/.env
# 2. Populate all empty SECRET and API key values with real production credentials.
# 3. Ensure file permissions are restricted (chmod 600 .env).
# ==============================================================================

# --- APPLICATION & RUNTIME ---
ENVIRONMENT=production
DEBUG=False
PORT=8002
HOST=127.0.0.1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be at least 32 bytes; never reuse a sample key.
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string

# Optional Fernet encryption key for sensitive data at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Local single-tenant / bootstrap authentication
LOCAL_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-to-strong-admin-password
DOKA_SINGLE_USER_EMAIL=admin@yourdomain.com

# --- SUPABASE AUTH & POSTGRES DATABASE ---
# Set database URL (PostgreSQL / Supabase Transaction Pooler or Direct)
# Example: postgresql+psycopg2://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./doka.db
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key

# --- CORS & SECURITY HARDENING ---
# Strict comma-separated allowlist of production origins (NO wildcards '*')
CORS_ORIGINS=https://doka.yourdomain.com,https://app.yourdomain.com

# --- DOCUMENT STORAGE BOUNDARIES (Native File System) ---
SOURCE_ROOT=/var/doka/data/source
WORKING_ROOT=/var/doka/data/workspace
FINAL_ROOT=/var/doka/data/workspace/final
QUARANTINE_ROOT=/var/doka/data/workspace/quarantine
BACKUP_ROOT=/var/doka/backups
ORIGINAL_READ_ONLY=true
ALLOW_SOURCE_WRITE=false
BACKUP_RETENTION_DAYS=30

# --- CLOUD OBJECT STORAGE (Optional: Cloudinary / S3 / R2) ---
DOKA_STORAGE_PROVIDER=disabled
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DOKA_STORAGE_MAX_OBJECT_BYTES=52428800
DOKA_STORAGE_MAX_TOTAL_BYTES=0

# --- OCR ENGINE CONFIGURATION ---
# Linux: /usr/bin/tesseract | Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract
MYANMAR_LANG=mya
OCR_DPI=300
OCR_PREPROCESSING=true
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
OCR_POPPLER_PATH=

# --- TELEGRAM BOT ALERTS & INCIDENT REPORTING ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

# --- SENTRY OBSERVABILITY & AUDIT ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# --- UNIFIED AI MULTI-PROVIDER ORCHESTRATION ---
AI_ENABLED=true
AI_EXTERNAL_PROCESSING_CONSENT=true
AI_ENHANCED_DUPLICATE_DETECTION=true
AI_CLASSIFICATION_ENABLED=true

# Provider Task Chains (Fallback cascade: openrouter -> groq -> gemini)
AI_PROVIDER_ORDER=openrouter,groq,gemini
AI_CLASSIFICATION_PROVIDER_ORDER=openrouter,groq,gemini
AI_PLANNING_PROVIDER_ORDER=openrouter,gemini
AI_FAST_PROVIDER_ORDER=groq,gemini
AI_EMBEDDING_PROVIDER_ORDER=openrouter

# AI Circuit Breaker & Safety Controls
AI_PROVIDER_MAX_ATTEMPTS=3
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_PROVIDER_FAILURE_THRESHOLD=3
AI_PROVIDER_COOLDOWN_SECONDS=30
AI_MAX_INPUT_CHARS=100000

# Provider API Keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- FRONTEND (Vite / React) ---
VITE_API_BASE_URL=https://doka.yourdomain.com/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_public_key
