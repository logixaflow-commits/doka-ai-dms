# =============================================================================
# Railway Deployment Environment Variables
# =============================================================================

# Application
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=${{RAILWAY_SECRET_KEY}}

# Database (Railway PostgreSQL)
DATABASE_URL=${{RAILWAY_POSTGRES_CONNECTION_STRING}}

# Redis (Railway Redis)
REDIS_URL=${{RAILWAY_REDIS_CONNECTION_STRING}}

# Storage (Disable MinIO for Railway, use local storage)
MINIO_ENABLED=false
STORAGE_TYPE=local

# OCR
TESSERACT_CMD=tesseract
MYANMAR_LANG=mya

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Set to your Railway app domain)
CORS_ORIGINS=https://your-app.railway.app

# AI Services (Optional)
OPENAI_API_KEY=${{OPENAI_API_KEY}}
GEMINI_API_KEY=${{GEMINI_API_KEY}}

# Celery (Optional - set to true if you want background tasks)
RAILWAY_ENABLE_WORKER=false
