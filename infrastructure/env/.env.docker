# =============================================================================
# Doka Docker environment template
# =============================================================================
# Copy this file to an untracked .env file and replace every <REQUIRED> value
# through the deployment secret manager. This template intentionally contains
# no usable credential, connection URL, domain, or production secret.
# =============================================================================

ENVIRONMENT=production
DEBUG=false
SECRET_KEY=<REQUIRED_32_PLUS_CHARACTER_RANDOM_SECRET>
ENCRYPTION_KEY=<REQUIRED_ENCRYPTION_KEY>

DATABASE_URL=<REQUIRED_POSTGRES_CONNECTION_URL>
POSTGRES_PASSWORD=<REQUIRED_POSTGRES_PASSWORD>
REDIS_URL=<REQUIRED_REDIS_CONNECTION_URL>
REDIS_PASSWORD=<REQUIRED_REDIS_PASSWORD>
CELERY_BROKER_URL=<REQUIRED_REDIS_CONNECTION_URL>
CELERY_RESULT_BACKEND=<REQUIRED_REDIS_CONNECTION_URL>

MINIO_IMAGE=<REQUIRED_IMMUTABLE_MINIO_TAG_OR_DIGEST>
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=<REQUIRED_MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<REQUIRED_MINIO_SECRET_KEY>
MINIO_SECURE=false
MINIO_BUCKET_NAME=<REQUIRED_MINIO_BUCKET_NAME>

TESSERACT_CMD=<OPTIONAL_TESSERACT_PATH>
MYANMAR_LANG=myan
OCR_DPI=300

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
2FA_MANDATORY_FOR_ADMIN=true
2FA_MAX_FAILED_ATTEMPTS=5
2FA_LOCKOUT_DURATION_MINUTES=15
2FA_ISSUER=Doka

CORS_ORIGINS=<REQUIRED_HTTPS_FRONTEND_ORIGIN>
TRUSTED_HOSTS=<REQUIRED_PUBLIC_API_HOSTNAME>
FOLDER_PERMISSIONS_ENABLED=true
ADMIN_ALL_FOLDERS_ACCESS=true
VECTOR_MODEL=<OPTIONAL_VECTOR_MODEL>
VECTOR_CACHE_ENABLED=true
RULE_ENGINE_BATCH_SIZE=100

SMTP_ENABLED=false
SMTP_SERVER=<OPTIONAL_SMTP_SERVER>
SMTP_PORT=587
SMTP_USERNAME=<OPTIONAL_SMTP_USERNAME>
SMTP_PASSWORD=<OPTIONAL_SMTP_PASSWORD>
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=<OPTIONAL_SMTP_FROM_EMAIL>
SMTP_FROM_NAME=Doka
ADMIN_EMAIL=<OPTIONAL_ADMIN_EMAIL>

OPENAI_API_KEY=<OPTIONAL_OPENAI_API_KEY>
OPENAI_MODEL=<OPTIONAL_OPENAI_MODEL>
CUSTOMS_API_URL=<OPTIONAL_CUSTOMS_API_URL>
CUSTOMS_API_KEY=<OPTIONAL_CUSTOMS_API_KEY>
SHIPPING_API_URL=<OPTIONAL_SHIPPING_API_URL>
SHIPPING_API_KEY=<OPTIONAL_SHIPPING_API_KEY>
