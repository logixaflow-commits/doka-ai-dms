{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doka-ai-dms",
  "main": "apps/web-platform/backend/cloudflare_worker/main.py",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["python_workers"],
  "keep_vars": true,
  "ratelimits": [
    {
      "name": "DOKA_RATE_LIMITER",
      "namespace_id": "7101001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DOKA_DB",
      "database_name": "doka-ai-dms-prod",
      "database_id": "4f3a294b-11ae-4ba7-903b-6f32539cebce"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://jkobgssaqifzrqfirdfu.supabase.co",
    "SUPABASE_STORAGE_BUCKET": "doka-documents",
    "TELEGRAM_CHAT_ID": "-1003992125718",
    "TELEGRAM_TOPIC_ID": "18",
    "TELEGRAM_ENABLED": "true",
    "DOKA_STORAGE_MAX_OBJECT_BYTES": "52428800",
    "DOKA_CORS_ORIGINS": "https://enterprise-ai-dms.vercel.app,https://enterprise-ai-dms-logixaflow-9859.vercel.app,https://enterprise-ai-dms-git-main-logixaflow-9859.vercel.app",
  },
  "previews": {}
}
