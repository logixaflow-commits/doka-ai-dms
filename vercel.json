{
  "version": 2,
  "framework": "vite",
  "installCommand": "cd web-platform/frontend && npm ci",
  "buildCommand": "cd web-platform/frontend && npm run build",
  "outputDirectory": "web-platform/frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- web-platform/frontend shared vercel.json"
}
