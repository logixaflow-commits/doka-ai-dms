# Supabase Auth (public browser-safe values; these are not secrets)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Production Python API base URL, including /api.
# Leave unset for local Vite proxy development.
# Do not set this to /api in production until a backend host/proxy is configured.
# VITE_API_BASE_URL=https://your-doka-api.example.com/api
