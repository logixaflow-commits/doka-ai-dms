# Personal Local production build: set VITE_DOKA_EDITION=personal-local at build time.
# Keep this unset for cloud/Vercel builds. The backend must use ENVIRONMENT=local or development.
# Do not configure real Supabase credentials when using Personal Local password authentication.
# VITE_DOKA_EDITION=personal-local

# Optional Supabase Auth for cloud/development integration (public browser-safe values).
# Leave the example placeholders unchanged for Personal Local mode; they are treated as unconfigured.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
VITE_SENTRY_DSN=

# Optional API origin override (no trailing slash and no /api suffix).
# Production defaults to https://doka.logixaflow.workers.dev.
# Leave unset for local Vite proxy development (localhost:8000).
# Example: VITE_API_BASE_URL=https://doka.logixaflow.workers.dev
