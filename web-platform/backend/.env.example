# Personal Local Edition environment template
# Copy to web-platform/backend/.env. Never commit the real .env.

ENVIRONMENT=development
DEBUG=False
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be at least 32 bytes; never reuse a sample key.
SECRET_KEY=

# Supabase Auth (required for the production API; example placeholders keep Personal Local auth active)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# CORS: when a remote API host is selected, replace with the exact frontend origin(s).
# Never use a wildcard for authenticated document APIs.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Local document boundaries
# Example Windows source: D:\\OfficeFiles
SOURCE_ROOT=
WORKING_ROOT=./Office_DMS/Workspace
FINAL_ROOT=./Office_DMS/Workspace/Final
QUARANTINE_ROOT=./Office_DMS/Workspace/Quarantine
BACKUP_ROOT=./Office_DMS/Backups
ORIGINAL_READ_ONLY=true
ALLOW_SOURCE_WRITE=false

# Backward-compatible enterprise paths (not used by the Personal Local runtime)
WATCH_FOLDER=./Office_DMS/Workspace/Watch_Folder
PROCESSING_WORKSPACE=./Office_DMS/Workspace/Processing_Workspace
ORGANIZED_ROOT=./Office_DMS/Workspace/Final
DUPLICATE_FOLDER=./Office_DMS/Workspace/Duplicates
SUSPICIOUS_FOLDER=./Office_DMS/Workspace/Quarantine/Suspicious
LOG_DIR=./logs

# OCR
TESSERACT_CMD=tesseract
MYANMAR_LANG=mya
OCR_DPI=300
OCR_PREPROCESSING=false
# Leave TESSDATA_PREFIX empty on Windows unless you deliberately installed tessdata elsewhere.
TESSDATA_PREFIX=

# Local login
LOCAL_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Durable local token revocation / refresh replay state (kept outside WORKING_ROOT).
# LOCAL_AUTH_STATE_PATH=./Office_DMS/database/local_auth_state.sqlite3

# Optional monitoring; document contents must never be sent to telemetry.
SENTRY_DSN=

# AI is optional and OFF by default.
AI_ENABLED=false
# Set true only after approving external processing of document content.
AI_EXTERNAL_PROCESSING_CONSENT=false
AI_ENHANCED_DUPLICATE_DETECTION=false
AI_CLASSIFICATION_ENABLED=false
AI_PROVIDER_ORDER=gemini,openrouter,groq,openai
AI_PROVIDER_MAX_ATTEMPTS=0
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=100000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Planned providers; adapters are NOT enabled until implemented and tested.
# NVIDIA Build product/API endpoint must be confirmed before enabling.
# NVIDIA_API_KEY=
# CEREBRAS_API_KEY=
# COHERE_API_KEY=
# VOYAGE_API_KEY=
# MISTRAL_API_KEY=
# Canva requires an OAuth/app integration; do not store a generic API key here.

# Backup
BACKUP_RETENTION_DAYS=30

# Cloud document storage (optional; disabled unless explicitly selected).
# Supabase uses the signed-in user's access token; do not put a service-role key here.
DOKA_STORAGE_PROVIDER=disabled
SUPABASE_STORAGE_BUCKET=doka-documents
DOKA_STORAGE_MAX_OBJECT_BYTES=52428800
DOKA_STORAGE_MAX_TOTAL_BYTES=0

# R2 is an optional larger-storage adapter. Keep credentials server-side only.
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Enterprise/cloud variables are intentionally not required for Personal Local mode.
