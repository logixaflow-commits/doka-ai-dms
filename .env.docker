# =============================================================================
# Enterprise AI DMS - Docker Deployment Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values before deployment.
# NEVER commit .env to version control.
# =============================================================================

# --- Core Application --------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
# SECRET_KEY: MUST be at least 32 random characters for JWT signing
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-random-string-min-32-chars

# --- Database ----------------------------------------------------------------
# PostgreSQL (Docker Compose uses these defaults)
DATABASE_URL=postgresql+psycopg2://dms_user:dms_password@postgres:5432/dms

# --- Redis & Celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO Object Storage ----------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=logistics-documents

# --- OCR Configuration -------------------------------------------------------
TESSERACT_CMD=tesseract
MYANMAR_LANG=mya
OCR_DPI=300

# --- Security & Compliance ---------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# --- CORS Configuration ------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Email/SMTP Configuration (Optional) -----------------------------------
# Set to true and configure SMTP settings to enable email notifications
SMTP_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@enterprise-dms.local
SMTP_FROM_NAME=Enterprise DMS
ADMIN_EMAIL=admin@enterprise-dms.local

# --- AI Services (Optional) --------------------------------------------------
# OpenAI API for AI-powered document analysis and duplicate detection
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Phase 2: Two-Factor Authentication (2FA) Settings ------------------------
2FA_MANDATORY_FOR_ADMIN=false
2FA_MAX_FAILED_ATTEMPTS=5
2FA_LOCKOUT_DURATION_MINUTES=15
2FA_ISSUER=EnterpriseDMS

# --- Phase 2: Folder Permissions -------------------------------------------
FOLDER_PERMISSIONS_ENABLED=true
ADMIN_ALL_FOLDERS_ACCESS=true

# --- Phase 3: AI Tagging & Vector Search --------------------------------------
VECTOR_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_CACHE_ENABLED=true
RULE_ENGINE_BATCH_SIZE=100

# --- Phase 4: External API Integration ----------------------------------------
# Customs API base URL
CUSTOMS_API_URL=
# Customs API key
CUSTOMS_API_KEY=
# Shipping API base URL
SHIPPING_API_URL=
# Shipping API key
SHIPPING_API_KEY=
